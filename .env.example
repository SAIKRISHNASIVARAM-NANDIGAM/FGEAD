# ==============================================================================
# FGEAD — Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables for your target environment.
# DO NOT commit real secrets or machine-specific credentials to version control.
# ==============================================================================

# Application Environment (DEVELOPMENT, TEST, PRODUCTION)
ENVIRONMENT=DEVELOPMENT
FGEAD_ENV=DEVELOPMENT

# Network & Server Configuration
FASTAPI_URL=http://127.0.0.1:8000
FGEAD_API_URL=http://127.0.0.1:8000
FGEAD_SERVER_HOST=127.0.0.1
FGEAD_SERVER_PORT=8000
STREAMLIT_SERVER_PORT=8501

# CORS Allowed Origins (Comma-separated list)
FGEAD_CORS_ORIGINS=http://localhost:8501,http://127.0.0.1:8501

# SQLite Multi-Host Registry Database Path & Timeout
FGEAD_DB_PATH=data/fgead_multihost.db
FGEAD_OFFLINE_TIMEOUT_SEC=15.0

# Security Secrets & Authentication Tokens (Use local secret placeholders)
FGEAD_API_SECRET_KEY=replace_with_local_secret
FGEAD_API_KEY=replace_with_local_secret
FGEAD_AGENT_TOKEN_SALT=replace_with_local_secret

# Hardware & Compute Device (cpu, cuda, or leave empty for auto-detect)
FGEAD_DEVICE=cpu

# SMD 38-Channel Benchmark Configuration
FGEAD_SMD_DATA_DIR=data/SMD
FGEAD_SMD_CHECKPOINT_PATH=checkpoints/fgead_smd_machine_1_1.pt
FGEAD_SMD_MACHINE_ID=1-1
FGEAD_SMD_THRESHOLD=2.073376

# Live 22-Channel Physical Model Paths & Defaults
FGEAD_LIVE_CHECKPOINT_PATH=checkpoints/fgead_live_windows_22ch.pt
FGEAD_LIVE_SCALER_PATH=checkpoints/fgead_live_scaler.joblib
FGEAD_LIVE_CONFIG_PATH=checkpoints/fgead_live_windows_22ch_config.json
FGEAD_LIVE_THRESHOLD_PATH=checkpoints/fgead_live_threshold.json
FGEAD_LIVE_THRESHOLD_DEFAULT=1.859450

# Logging & Diagnostic Output
FGEAD_LOG_LEVEL=INFO
FGEAD_STRUCTURED_LOGS=true
